# Wallet to copy
TARGET_WALLET=0x204f72f35326db932158cba6adff0b9a1da95e14

# Paper trading starting balance
STARTING_BALANCE=10000

# Set true only when ready for live orders (also pick "Real trading" in the app)
ENABLE_REAL_TRADING=false

# Real trading credentials (never commit .env)
PRIVATE_KEY=
RELAYER_API_KEY=
RELAYER_API_SECRET=
RELAYER_API_PASSPHRASE=

# Copy sizing & risk
COPY_TRADE_SIZE_USD=5
MAX_SLIPPAGE=0.02
MAX_POSITION_PER_MARKET=25
POLL_INTERVAL=12
LOOKBACK_HOURS=24
